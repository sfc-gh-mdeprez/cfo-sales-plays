{"status":"ok","definitions":[{"calcId":"CALC-rev","accountCode":"rev","accountName":"Total Revenue","accountType":"IS","isLeaf":false,"expression":"SUM(rev-gross, rev-ded)","dependsOn":["rev-gross","rev-ded"],"statementSection":"IS","calcVersion":1,"rationale":"Total Revenue = Gross Sales − GTN Deductions","isActive":true,"updatedBy":"SEED","updatedAt":"2026-11-08 04:47:34.264","parentAccountCode":null},{"calcId":"CALC-cogs-pct","accountCode":"cogs-pct","accountName":"Cost of Sales % of Revenue","accountType":"IS","isLeaf":false,"expression":"cogs / rev * 100","dependsOn":["cogs","rev"],"statementSection":"IS","calcVersion":1,"rationale":"This KPI provides a direct measure of manufacturing efficiency and cost structure, complementing the existing Gross Margin % (gp-pct) by showing the cost side explicitly. It enables management to track cost inflation, manufacturing productivity, and pricing power trends.","isActive":true,"updatedBy":"MANAGED_SERVICE_82","updatedAt":"2026-11-10 03:32:01.934","parentAccountCode":null},{"calcId":"CALC-cogs","accountCode":"cogs","accountName":"Cost of Sales","accountType":"IS","isLeaf":false,"expression":"SUM(cogs-mat, cogs-lab, cogs-oh)","dependsOn":["cogs-mat","cogs-lab","cogs-oh"],"statementSection":"IS","calcVersion":1,"rationale":"Cost of Sales = API + Manufacturing Conversion + Packaging, QC & Royalties","isActive":true,"updatedBy":"SEED","updatedAt":"2026-11-08 04:47:34.264","parentAccountCode":null},{"calcId":"CALC-gp","accountCode":"gp","accountName":"Gross Profit","accountType":"IS","isLeaf":false,"expression":"SUM(rev, -cogs)","dependsOn":["rev","cogs"],"statementSection":"IS","calcVersion":1,"rationale":"Gross Profit = Total Revenue − Cost of Sales","isActive":true,"updatedBy":"SEED","updatedAt":"2026-11-08 04:47:34.264","parentAccountCode":null},{"calcId":"CALC-gp-pct","accountCode":"gp-pct","accountName":"Gross Margin %","accountType":"IS","isLeaf":false,"expression":"gp / rev * 100","dependsOn":["gp","rev"],"statementSe