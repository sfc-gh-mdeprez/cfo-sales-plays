{"status":"ok","data":[{"calcId":"CALC-bs-assets","accountCode":"bs-assets","expression":"SUM(bs-ca, bs-nca)","dependsOn":["bs-ca","bs-nca"],"rationale":"Total Assets = Current Assets + Non-Current Assets"},{"calcId":"CALC-bs-ca","accountCode":"bs-ca","expression":"SUM(bs-cash, bs-ar, bs-inv, bs-prepaid)","dependsOn":["bs-cash","bs-ar","bs-inv","bs-prepaid"],"rationale":"Current Assets = Cash + Receivables + Inventories + Prepaids"},{"calcId":"CALC-bs-cl","accountCode":"bs-cl","expression":"SUM(bs-ap, bs-accrued, bs-st-debt, bs-def-rev)","dependsOn":["bs-ap","bs-accrued","bs-st-debt","bs-def-rev"],"rationale":"Current Liabilities = Payables + Accruals + ST Debt + GTN Accruals"},{"calcId":"CALC-bs-equity","accountCode":"bs-equity","expression":"SUM(bs-share-cap, bs-retained, bs-oci)","dependsOn":["bs-share-cap","bs-retained","bs-oci"],"rationale":"Equity = Share Capital + Retained Earnings + OCI"},{"calcId":"CALC-bs-inv","accountCode":"bs-inv","expression":"SUM(bs-inv-rm, bs-inv-wip, bs-inv-fg)","dependsOn":["bs-inv-rm","bs-inv-wip","bs-inv-fg"],"rationale":"Inventories = API + Drug Substance (WIP) + Finished Goods"},{"calcId":"CALC-bs-liab-eq","accountCode":"bs-liab-eq","expression":"SUM(bs-cl, bs-ncl, bs-equity)","dependsOn":["bs-cl","bs-ncl","bs-equity"],"rationale":"Total Liabilities & Equity = Current Liabilities + Non-Current Liabilities + Equity"},{"calcId":"CALC-bs-nca","accountCode":"bs-nca","expression":"SUM(bs-ppe-gross, bs-accum-dep, bs-intangibles, bs-other-nca)","dependsOn":["bs-ppe-gross","bs-accum-dep","bs-intangibles","bs-other-nca"],"rationale":"Non-Current Assets = PP&E + Accum. Depreciation + Intangibles & Goodwill + Other"},{"calcId":"CALC-bs-ncl","accountCode":"bs-ncl","expression":"SUM(bs-lt-debt, bs-def-tax, bs-other-ncl)","dependsOn":["bs-lt-debt","bs-def-tax","bs-other-ncl"],"rationale":"Non-Current Liabilities = LT Debt + Deferred Tax + Other"},{"calcId":"CALC-cf-end-cash","accountCode":"cf-end-cash","expression":"SUM(cf-net, cf-beg-cash)","dependsOn":["cf-net","cf-beg-cash"],"rationale":"Closing Cash = Net Change + Opening Cash"},{"calcId":"CALC-cf-net","accountCode":"cf-net","expression":"SUM(cfo, cfi, cff)","dependsOn":["cfo","cfi","cff"],"rationale":"Net Change in Cash = CFO + CFI + CFF"},{"calcId":"CALC-cff","accountCode":"cff","expression":"SUM(cf-debt, cf-equity, cf-div)","dependsOn":["cf-debt","cf-equity","cf-div"],"rationale":"Net Cash Outflow from Financing Activities = Debt + Share Buyback + Dividends"},{"calcId":"CALC-cfi","accountCode":"cfi","expression":"SUM(cf-capex, cf-disposals, cf-acq)","dependsOn":["cf-capex","cf-disposals","cf-acq"],"rationale":"Net Cash Outflow from Investing Activities = CapEx + Disposals + Acquisitions / Licensing"},{"calcId":"CALC-cfo","accountCode":"cfo","expression":"SUM(cf-ni, cf-da, cf-dar, cf-dinv, cf-dap, cf-dwc)","dependsOn":["cf-ni","cf-da","cf-dar","cf-dinv","cf-dap","cf-dwc"],"rationale":"Net Cash Inflow from Operating Activities = PAT + D&A + Working Capital"},{"calcId":"CALC-cogs","accountCode":"cogs","expression":"SUM(cogs-mat, cogs-lab, cogs-oh)","dependsOn":["cogs-mat","cogs-lab","cogs-oh"],"rationale":"Cost of Sales = API + Manufacturing Conversion + Packaging, QC & Royalties"},{"calcId":"CALC-da","accountCode":"da","expression":"SUM(da-plants, da-facilities, da-tech)","dependsOn":["da-plants","da-facilities","da-tech"],"rationale":"Depreciation, Amortisation & Impairment = Product Intangibles + Sites + IT & Software"},{"calcId":"CALC-ebit","accountCode":"ebit","expression":"SUM(ebitda, -da)","dependsOn":["ebitda","da"],"rationale":"Operating Profit = EBITDA − D&A"},{"calcId":"CALC-ebit-pct","accountCode":"ebit-pct","expression":"ebit / rev * 100","dependsOn":["ebit","rev"],"rationale":"Operating Margin % = Operating Profit / Total Revenue x 100"},{"calcId":"CALC-ebitda","accountCode":"ebitda","expression":"SUM(gp, -opex-excl)","dependsOn":["gp","opex-excl"],"rationale":"EBITDA = GP − OpEx"},{"calcId":"CALC-ebitda-pct","accountCode":"ebitda-pct","expression":"ebitda / rev * 100","dependsOn":["ebitda","rev"],"rationale":"EBITDA Margin % = EBITDA / Total Revenue x 100"},{"calcId":"CALC-ebt","accountCode":"ebt","expression":"SUM(ebit, nonop)","dependsOn":["ebit","nonop"],"rationale":"Profit Before Tax = Operating Profit + Net Finance Expense"},{"calcId":"CALC-fcf","accountCode":"fcf","expression":"SUM(cfo, cf-capex)","dependsOn":["cfo","cf-capex"],"rationale":"Free Cash Flow = CFO + CapEx"},{"calcId":"CALC-gp","accountCode":"gp","expression":"SUM(rev, -cogs)","dependsOn":["rev","cogs"],"rationale":"Gross Profit = Total Revenue − Cost of Sales"},{"calcId":"CALC-gp-pct","accountCode":"gp-pct","expression":"gp / rev * 100","dependsOn":["gp","rev"],"rationale":"Gross Margin % = GP / Total Revenue x 100"},{"calcId":"CALC-ni","accountCode":"ni","expression":"SUM(ebt, -tax)","dependsOn":["ebt","tax"],"rationale":"Profit After Tax = Profit Before Tax − Taxation"},{"calcId":"CALC-ni-pct","accountCode":"ni-pct","expression":"ni / rev * 100","dependsOn":["ni","rev"],"rationale":"Net Margin % = PAT / Total Revenue x 100"},{"calcId":"CALC-nonop","accountCode":"nonop","expression":"SUM(nonop-ii, -nonop-ie, nonop-oth)","dependsOn":["nonop-ii","nonop-ie","nonop-oth"],"rationale":"Net Finance Expense = Interest Income − Interest Expense + Other Financial"},{"calcId":"CALC-opex-excl","accountCode":"opex-excl","expression":"SUM(opex-sm, opex-rd, opex-ga)","dependsOn":["opex-sm","opex-rd","opex-ga"],"rationale":"Operating Expenses (excl. D&A) = Selling, Marketing & Distribution + R&D + G&A"},{"calcId":"CALC-rev","accountCode":"rev","expression":"SUM(rev-gross, rev-ded)","dependsOn":["rev-gross","rev-ded"],"rationale":"Total Revenue = Gross Sales − GTN Deductions"}]}