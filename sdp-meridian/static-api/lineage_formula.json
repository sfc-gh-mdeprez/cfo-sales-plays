{"status":"ok","data":[{"calcId":"CALC-bs-assets","accountCode":"bs-assets","expression":"SUM(bs-ca, bs-nca)","dependsOn":["bs-ca","bs-nca"],"rationale":"Total Assets = Current Assets + Non-Current Assets"},{"calcId":"CALC-bs-ca","accountCode":"bs-ca","expression":"SUM(bs-cash, bs-ar, bs-inv, bs-prepaid)","dependsOn":["bs-cash","bs-ar","bs-inv","bs-prepaid"],"rationale":"Current Assets = Cash + Receivables + Inventories + Prepaids"},{"calcId":"CALC-bs-cl","accountCode":"bs-cl","expression":"SUM(bs-ap, bs-accrued, bs-st-debt, bs-def-rev)","dependsOn":["bs-ap","bs-accrued","bs-st-debt","bs-def-rev"],"rationale":"Current Liabilities = Payables + Accruals + ST Debt + Royalties & Taxes Payable"},{"calcId":"CALC-bs-equity","accountCode":"bs-equity","expression":"SUM(bs-share-cap, bs-retained, bs-oci)","dependsOn":["bs-share-cap","bs-retained","bs-oci"],"rationale":"Equity = Share Capital + Retained Earnings + OCI"},{"calcId":"CALC-bs-inv","accountCode":"bs-inv","expression":"SUM(bs-inv-rm, bs-inv-wip, bs-inv-fg)","dependsOn":["bs-inv-rm","bs-inv-wip","bs-inv-fg"],"rationale":"Inventories = Crude + In-Process + Refined Products & Polymers"},{"calcId":"CALC-bs-liab-eq","accountCode":"bs-liab-eq","expression":"SUM(bs-cl, bs-ncl, bs-equity)","dependsOn":["bs-cl","bs-ncl","bs-equity"],"rationale":"Total Liabilities & Equity = Current Liabilities + Non-Current Liabilities + Equity"},{"calcId":"CALC-bs-nca","accountCode":"bs-nca","expression":"SUM(bs-ppe-gross, bs-accum-dep, bs-intangibles, bs-other-nca)","dependsOn":["bs-ppe-gross","bs-accum-dep","bs-intangibles","bs-other-nca"],"rationale":"Non-Current Assets = PP&E + Accum. DD&A + Intangibles + Investments"},{"calcId":"CALC-bs-ncl","accountCode":"bs-ncl","expression":"SUM(bs-lt-debt, bs-def-tax, bs-other-ncl)","dependsOn":["bs-lt-debt","bs-def-tax","bs-other-ncl"],"rationale":"Non-Current Liabilities = Bonds & Sukuk + Deferred Tax + Provisions"},{"calcId":"CALC-cf-end-cash","accountCode":"cf-end-cash","expression":"SUM(cf-net, cf-beg-cash)","dependsOn":["cf-net","cf-beg-cash"],"rationale":"Ending Cash = Net Change + Beginning Cash"},{"calcId":"CALC-cf-net","accountCode":"cf-net","expression":"SUM(cfo, cfi, cff)","dependsOn":["cfo","cfi","cff"],"rationale":"Net Change in Cash = CFO + CFI + CFF"},{"calcId":"CALC-cff","accountCode":"cff","expression":"SUM(cf-debt, cf-equity, cf-div)","dependsOn":["cf-debt","cf-equity","cf-div"],"rationale":"Cash Flow from Financing Activities = Borrowings + Equity + Dividends"},{"calcId":"CALC-cfi","accountCode":"cfi","expression":"SUM(cf-capex, cf-disposals, cf-acq)","dependsOn":["cf-capex","cf-disposals","cf-acq"],"rationale":"Cash Flow from Investing Activities = CapEx + Disposals + Acquisitions"},{"calcId":"CALC-cfo","accountCode":"cfo","expression":"SUM(cf-ni, cf-da, cf-dar, cf-dinv, cf-dap, cf-dwc)","dependsOn":["cf-ni","cf-da","cf-dar","cf-dinv","cf-dap","cf-dwc"],"rationale":"Cash Flow from Operating Activities = Net Income + DD&A + Working Capital"},{"calcId":"CALC-cogs","accountCode":"cogs","expression":"SUM(cogs-mat, cogs-lab, cogs-oh)","dependsOn":["cogs-mat","cogs-lab","cogs-oh"],"rationale":"Cost of Sales = Purchases & Royalties + Producing Personnel + Operations, Refining & Transport"},{"calcId":"CALC-da","accountCode":"da","expression":"SUM(da-plants, da-facilities, da-tech)","dependsOn":["da-plants","da-facilities","da-tech"],"rationale":"Depreciation, Depletion & Amortisation = Producing Assets + Facilities + Intangibles"},{"calcId":"CALC-ebit","accountCode":"ebit","expression":"SUM(ebitda, -da)","dependsOn":["ebitda","da"],"rationale":"Operating Income (EBIT) = EBITDA − DD&A"},{"calcId":"CALC-ebit-pct","accountCode":"ebit-pct","expression":"ebit / rev * 100","dependsOn":["ebit","rev"],"rationale":"Operating Margin % = EBIT / Revenue x 100"},{"calcId":"CALC-ebitda","accountCode":"ebitda","expression":"SUM(gp, -opex-excl)","dependsOn":["gp","opex-excl"],"rationale":"EBITDA = Gross Profit − OpEx"},{"calcId":"CALC-ebitda-pct","accountCode":"ebitda-pct","expression":"ebitda / rev * 100","dependsOn":["ebitda","rev"],"rationale":"EBITDA Margin % = EBITDA / Revenue x 100"},{"calcId":"CALC-ebt","accountCode":"ebt","expression":"SUM(ebit, nonop)","dependsOn":["ebit","nonop"],"rationale":"Income Before Income Taxes & Zakat = EBIT + Finance & Other"},{"calcId":"CALC-fcf","accountCode":"fcf","expression":"SUM(cfo, cf-capex)","dependsOn":["cfo","cf-capex"],"rationale":"Free Cash Flow = CFO + CapEx"},{"calcId":"CALC-gp","accountCode":"gp","expression":"SUM(rev, -cogs)","dependsOn":["rev","cogs"],"rationale":"Gross Profit = Revenue − Cost of Sales"},{"calcId":"CALC-gp-pct","accountCode":"gp-pct","expression":"gp / rev * 100","dependsOn":["gp","rev"],"rationale":"Gross Margin % = Gross Profit / Revenue x 100"},{"calcId":"CALC-ni","accountCode":"ni","expression":"SUM(ebt, -tax)","dependsOn":["ebt","tax"],"rationale":"Net Income = Income Before Tax − Taxes & Zakat"},{"calcId":"CALC-ni-pct","accountCode":"ni-pct","expression":"ni / rev * 100","dependsOn":["ni","rev"],"rationale":"Net Income Margin % = Net Income / Revenue x 100"},{"calcId":"CALC-nonop","accountCode":"nonop","expression":"SUM(nonop-ii, -nonop-ie, nonop-oth)","dependsOn":["nonop-ii","nonop-ie","nonop-oth"],"rationale":"Finance & Other Income = Finance Income − Finance Costs + Other"},{"calcId":"CALC-opex-excl","accountCode":"opex-excl","expression":"SUM(opex-sm, opex-rd, opex-ga)","dependsOn":["opex-sm","opex-rd","opex-ga"],"rationale":"Operating Expenses = Selling & Distribution + Exploration + General & Administrative"},{"calcId":"CALC-rev","accountCode":"rev","expression":"SUM(rev-gross, rev-ded)","dependsOn":["rev-gross","rev-ded"],"rationale":"Revenue = Gross Sales − OSP Adjustments & Discounts"}]}